{
	"name": "FactoryOS Polyglot DevEnv",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
	"workspaceFolder": "${localWorkspaceFolder}",
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/java:1": {
			"version": "21",
			"installMaven": "true",
			"installGradle": "true"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "20",
			"nodeGypDependencies": true
		},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"moby": false,
			"installDockerBuildx": true
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.gopath": "/go",
				"java.configuration.updateBuildConfiguration": "automatic",
				"editor.formatOnSave": true
			},
			"extensions": [
				"golang.go",
				"vscjava.vscode-java-pack",
				"vscjava.vscode-java-debug",
				"vscjava.vscode-java-test",
				"vscjava.vscode-maven",
				"vmware.vscode-spring-boot",
				"bufbuild.vscode-buf",
				"drblury.protobuf-vsc",
				"ms-azuretools.vscode-docker",
				"mermaidchart.vscode-mermaid-chart",
				"anthropic.claude-code"
			]
		}
	},
	"runArgs": [
		"--network=factoryos_net"
	],
	"initializeCommand": "docker network inspect factoryos_net >/dev/null 2>&1 || docker network create factoryos_net",
	"remoteUser": "vscode",
	// Run commands after the container is created to install any global tools
	"postCreateCommand": "make install-tools"
}