# FactoryOS Analytics Engine — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.

# --- HTTP Server ---
METRICS_PORT=:8082
SHUTDOWN_TIMEOUT=5s

# --- Kafka Consumer ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=telemetry.raw.v1
KAFKA_GROUP_ID=analytics-engine-group
KAFKA_MIN_BYTES=10240
KAFKA_MAX_BYTES=10485760
KAFKA_MAX_WAIT=100ms
KAFKA_COMMIT_INTERVAL=500ms
KAFKA_RETRY_BACKOFF=50ms

# --- TimescaleDB Connection ---
# Replace <password> with the actual secret (use a secrets manager in production).
DATABASE_URL=postgres://factoryos:<password>@localhost:5432/factoryos?sslmode=disable
DATABASE_TABLE_NAME=raw_telemetry
DATABASE_MAX_CONNS=30
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=15m
DATABASE_PING_TIMEOUT=5s
TELEMETRY_RAW_RETENTION_DAYS=30

# --- Ingestion Tuning ---
BATCH_SIZE=500
FLUSH_INTERVAL=200ms
CHANNEL_CAPACITY_MULTIPLIER=4
