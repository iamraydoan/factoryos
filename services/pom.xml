<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      One Spring Boot for the whole build. Every service inherits from here, so a
      service that declares spring-boot-starter-parent directly would resolve a
      different Boot major than its siblings. See docs/10-developer-guide/
      ERROR_HANDLING_TUTORIAL.md Part 2.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.factoryos</groupId>
    <artifactId>factoryos-services-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FactoryOS Domain Services Parent</name>
    <description>Parent POM for all FactoryOS Spring Boot microservices</description>

    <properties>
        <java.version>21</java.version>
        <factoryos-common-error.version>0.1.0-SNAPSHOT</factoryos-common-error.version>
    </properties>

    <!--
      The two libs/ modules are NOT listed until they exist: a <module> pointing at
      a directory with no pom.xml fails the whole reactor. Part 3 of the tutorial
      adds factoryos-common-error here, and Part 4 adds the adapters.
    -->
    <modules>
        <module>production-service</module>
        <module>warehouse-service</module>
        <module>quality-service</module>
        <module>maintenance-service</module>
        <module>planning-service</module>
        <module>../libs/factoryos-common-error</module>
        <module>../libs/factoryos-common-error-adapters</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Versions only: services opt in by declaring the dependency. -->
            <dependency>
                <groupId>com.factoryos</groupId>
                <artifactId>factoryos-common-error</artifactId>
                <version>${factoryos-common-error.version}</version>
            </dependency>
            <dependency>
                <groupId>com.factoryos</groupId>
                <artifactId>factoryos-common-error-adapters</artifactId>
                <version>${factoryos-common-error.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          Spring Boot 4 renamed spring-boot-starter-web to spring-boot-starter-webmvc.
          The old artifact name does not exist at 4.1.1, so it must not be used.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
