# FactoryOS Ingestion Service Configuration Template
GRPC_PORT=:50051
METRICS_PORT=:8083
SHUTDOWN_TIMEOUT=5s

# Kafka Producer Settings
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=telemetry.raw.v1
KAFKA_PRODUCER_BATCH_SIZE=500
KAFKA_PRODUCER_BATCH_TIMEOUT=10ms
KAFKA_REQUIRED_ACKS=1
KAFKA_PRODUCER_ASYNC=false
