# ==============================================================================
# Resource Service - Environment Variables
# ==============================================================================
# Copy this file to .env and update values for your local environment.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL ---
# Local: postgres://user:password@localhost:5432/dbname?sslmode=disable
# Dev Container: postgres://user:password@factoryos_db:5432/dbname?sslmode=disable
DB_URL=postgres://user:password@localhost:5432/factoryos?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_PING_TIMEOUT=5s

# --- gRPC Server ---
SERVER_PORT=:50052
SERVER_METRICS_PORT=:9092
SERVER_SHUTDOWN_TIMEOUT=5s
