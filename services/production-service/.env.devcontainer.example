# production-service — DEVCONTAINER profile.
#
#   DB -> container name (devcontainer joins factoryos_net)
#   Copy with: make setup-env-devcontainer
#   (or cp services/production-service/.env.devcontainer.example services/production-service/.env)

# Server
SERVER_PORT=3001
GRPC_SERVER_PORT=4001

# Database — Docker network (devcontainer / compose).
DB_HOST=factoryos-db
DB_USER=factoryos
DB_PASSWORD=factoryos_password
