# production-service — DOCKER profile.
#   DB -> container name (service runs as a compose container)
#   Copy with: make setup-env-docker

# Server
SERVER_PORT=3001
GRPC_SERVER_PORT=4001

# Database — Docker network (devcontainer / compose).
DB_HOST=factoryos-db
DB_USER=factoryos
DB_PASSWORD=factoryos_password
