# Local Docker Compose host ports. Container-side ports remain fixed.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_GRPC_PORT=50051
FACTORYOS_DB_PORT=5432
ZITADEL_DB_PORT=5433
ZITADEL_PORT=8081
KAFKA_PORT=9092
VALKEY_PORT=6379
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
SWAGGER_UI_PORT=8082

# Local development credentials only. Use strong, unique values outside local development.
FACTORYOS_DB_USER=factoryos
FACTORYOS_DB_PASSWORD=factoryos_password
FACTORYOS_DB_NAME=factoryos
ZITADEL_DB_USER=postgres
ZITADEL_DB_PASSWORD=zitadel_password
ZITADEL_DB_NAME=zitadel

# Zitadel master key must be exactly 32 characters.
ZITADEL_MASTERKEY=12345678901234567890123456789012
ZITADEL_ADMIN_PASSWORD=Password123!
ZITADEL_EXTERNAL_DOMAIN=localhost