# FactoryOS root env — DEVCONTAINER profile.
#
#   DB (factoryos-db)      -> container name (devcontainer joins factoryos_net)
#   Gateway backends       -> host.docker.internal (service runs on the host side)
#
# Copy with: make setup-env-devcontainer   (or cp .env.devcontainer.example .env)

# Local Docker Compose host ports. Container-side ports remain fixed.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_GRPC_PORT=50051
FACTORYOS_DB_PORT=5432
ZITADEL_DB_PORT=5433
ZITADEL_PORT=8081
KAFKA_PORT=9092
VALKEY_PORT=6379
MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001
SWAGGER_UI_PORT=3080

# Domain service ports (host = container). REST on 3xxx, gRPC on 4xxx.
PRODUCTION_REST_PORT=3001
PRODUCTION_GRPC_PORT=4001

# Local development credentials only. Use strong, unique values outside local development.
FACTORYOS_DB_USER=factoryos
FACTORYOS_DB_PASSWORD=factoryos_password
FACTORYOS_DB_NAME=factoryos
ZITADEL_DB_USER=postgres
ZITADEL_DB_PASSWORD=zitadel_password
ZITADEL_DB_NAME=zitadel

# Zitadel master key must be exactly 32 characters.
ZITADEL_MASTERKEY=12345678901234567890123456789012
ZITADEL_ADMIN_PASSWORD=Password123!
ZITADEL_EXTERNAL_DOMAIN=localhost

# Gateway backend targets (Traefik file provider, dynamic/*.yaml).
# Devcontainer default: Traefik in Docker dials back to services running on the host.
PRODUCTION_REST_BACKEND=http://host.docker.internal:3001
PRODUCTION_GRPC_BACKEND=h2c://host.docker.internal:4001

# Browser CORS allow-list for the gateway (Traefik api-cors middleware).
# YAML list syntax, comma-separated origins. Extend for your web frontend.
CORS_ALLOW_ORIGIN_LIST=[http://localhost:3080,http://127.0.0.1:3080]
